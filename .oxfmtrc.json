{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "printWidth": 100,
  "ignorePatterns": [
    "node_modules",
    ".next",
    "dist",
    "target",
    "pnpm-lock.yaml",
    "**/*.sqlite3*"
  ]
}
