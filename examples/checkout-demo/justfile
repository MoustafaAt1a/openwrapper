# OpenWrapper Multi-SDK Checkout Demo Task Runner (Justfile)

default:
    @just --list

# Start ALL 3 servers concurrently (TypeScript :4000, PHP :4001, .NET :4002)
start: start-all

# Start ALL 3 servers concurrently (TypeScript :4000, PHP :4001, .NET :4002)
start-all:
    node scripts/start-all.mjs

# Run TypeScript server only on port 4000
start-ts:
    cd typescript && node server.js

# Run PHP 8 server only on port 4001
start-php:
    php -c php/php.ini -S 0.0.0.0:4001 php/server.php

# Run .NET 8 server only on port 4002
start-dotnet:
    dotnet run --project dotnet/CheckoutDemo.csproj

# Run CLI live tests sequentially across all 3 SDKs
test-all: test-cli-ts test-cli-php test-cli-dotnet

# Run TypeScript CLI live transaction test
test-cli-ts:
    cd typescript && node test-cli.js

# Run PHP CLI live transaction test
test-cli-php:
    php -c php/php.ini php/test-cli.php

# Run .NET CLI live transaction test
test-cli-dotnet:
    dotnet run --project dotnet/CheckoutDemo.csproj -- --cli

# Run syntax & build verification across all SDKs
check:
    node --check typescript/server.js
    node --check typescript/test-cli.js
    node --check public/app.js
    php -l php/server.php
    php -l php/test-cli.php
    dotnet build dotnet/CheckoutDemo.csproj

# Run end-to-end API test suite
verify:
    node scripts/verify-api.mjs

# Install and restore dependencies
install:
    cd typescript && bun install
    dotnet restore dotnet/CheckoutDemo.csproj
