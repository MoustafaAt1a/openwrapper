{
  "name": "openwrapper-checkout-demo",
  "version": "0.1.2",
  "private": true,
  "description": "Multi-SDK Real-World Checkout Store Demo using TypeScript, PHP, and .NET OpenWrapper SDKs",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:ts": "node server.js",
    "start:php": "php -S 0.0.0.0:4001 php/server.php",
    "start:dotnet": "dotnet run --project dotnet/CheckoutDemo.csproj",
    "test:cli": "node test-cli.js",
    "test:cli:ts": "node test-cli.js",
    "test:cli:php": "php php/test-cli.php",
    "test:cli:dotnet": "dotnet run --project dotnet/CheckoutDemo.csproj -- --cli",
    "check": "node --check server.js && node --check test-cli.js && node --check public/app.js"
  },
  "dependencies": {
    "@openwrapper/sdk": "file:../../sdk/typescript"
  },
  "engines": {
    "node": ">=18"
  }
}
