# ==============================================================================
# OpenWrapper Multi-SDK Real Checkout Demo Configuration (.env.example)
#
# Copy this file to .env:
#   cp .env.example .env
#
# Supported SDK Backends:
#   - TypeScript (:4000)
#   - PHP 8      (:4001)
#   - .NET 8     (:4002)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gateway Connection Settings
# ------------------------------------------------------------------------------
# Production / Staging Gateway:
# OPENWRAPPER_BASE_URL=https://gateway.openwrapper.muejam.com
# Local Next.js API / Dev Gateway:
OPENWRAPPER_BASE_URL=http://localhost:3000/api
# Local Rust Gateway (Standalone):
# OPENWRAPPER_BASE_URL=http://localhost:8080/api/v1

# OpenWrapper API Key (Leave unset if testing stateless mode on local gateway)
OPENWRAPPER_API_KEY=ow_live_your_api_key_here

# Default provider for CLI transaction test runner (paymob, fawry, stripe)
OPENWRAPPER_TEST_PROVIDER=paymob

# ------------------------------------------------------------------------------
# 2. Server Ports
# ------------------------------------------------------------------------------
PORT=4000
PHP_PORT=4001
DOTNET_PORT=4002

# ------------------------------------------------------------------------------
# 3. Paymob Credentials (Egypt Cards, Mobile Wallets, Meeza)
# ------------------------------------------------------------------------------
# From Paymob Dashboard -> Settings / Developers
PAYMOB_SECRET_KEY=egy_sk_test_...
PAYMOB_PUBLIC_KEY=egy_pk_test_...
PAYMOB_HMAC_SECRET=...
PAYMOB_INTEGRATION_ID=...
# Optional custom API base URL (defaults to https://accept.paymob.com/api)
# PAYMOB_BASE_URL=https://accept.paymob.com/api

# ------------------------------------------------------------------------------
# 4. Fawry Pay Credentials (Retail Kiosk Code, Fawry Plus)
# ------------------------------------------------------------------------------
# From Fawry Merchant Staging / Production Portal
FAWRY_MERCHANT_CODE=1013970
FAWRY_SECURE_KEY=...
# Optional custom API base URL (defaults to https://atfawry.fawry.com)
# FAWRY_BASE_URL=https://atfawry.fawry.com

# ------------------------------------------------------------------------------
# 5. Stripe Credentials (International Cards, Apple Pay)
# ------------------------------------------------------------------------------
# From Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_test_...
