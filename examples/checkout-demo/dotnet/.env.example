# ==============================================================================
# OpenWrapper .NET Checkout Demo Configuration (.env.example)
#
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

OPENWRAPPER_BASE_URL=http://localhost:3000/api
OPENWRAPPER_API_KEY=ow_live_your_api_key_here
OPENWRAPPER_TEST_PROVIDER=paymob

DOTNET_PORT=4002

# Paymob Credentials (Egypt Cards, Mobile Wallets, Meeza)
PAYMOB_SECRET_KEY=egy_sk_test_...
PAYMOB_PUBLIC_KEY=egy_pk_test_...
PAYMOB_HMAC_SECRET=...
PAYMOB_INTEGRATION_ID=...
PAYMOB_WALLET_INTEGRATION_ID=...

# Fawry Pay Credentials (Retail Kiosk Code, Fawry Plus)
FAWRY_MERCHANT_CODE=1013970
FAWRY_SECURE_KEY=...

# Stripe Credentials (International Cards, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=sk_test_...

