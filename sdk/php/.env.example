# ==============================================================================
# OpenWrapper PHP SDK Environment Variables (.env.example)
# Target: PHP 8.1+ / Composer (Package: openwrapper/sdk v0.1.3)
#
# QUICK START:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GATEWAY CONNECTION SETTINGS
# ------------------------------------------------------------------------------
# Target OpenWrapper Gateway or Web Proxy URL
# - Local Rust Gateway: "http://localhost:8080"
# - Local Next.js API Proxy: "http://localhost:3000/api"
# - Production Gateway: "https://gateway.example.com"
OPENWRAPPER_BASE_URL=http://localhost:8080

# Merchant API Key generated from the OpenWrapper dashboard (starts with ow_live_ or ow_test_)
OPENWRAPPER_API_KEY=ow_live_your_api_key_here

# ------------------------------------------------------------------------------
# 2. STATELESS PROVIDER CREDENTIALS (PASSED PER-REQUEST OVER TLS)
# ------------------------------------------------------------------------------
# In OpenWrapper's stateless zero-storage mode, credentials set here are forwarded
# as dynamic HTTP headers (X-Paymob-*, X-Fawry-*, X-Stripe-*) without database storage.

# --- Paymob (Egypt Cards, Mobile Wallets, Meeza) ---
PAYMOB_SECRET_KEY=egy_sk_test_...
PAYMOB_PUBLIC_KEY=egy_pk_test_...
PAYMOB_HMAC_SECRET=...
PAYMOB_INTEGRATION_ID=123456
# Optional Mobile Wallet Integration ID:
PAYMOB_WALLET_INTEGRATION_ID=123457

# --- Fawry Pay (Retail Kiosks & Reference Codes) ---
FAWRY_MERCHANT_CODE=1013970
FAWRY_SECURE_KEY=...
# Optional Fawry Base URL (defaults to staging):
FAWRY_BASE_URL=https://atfawry.fawrystaging.com

# --- Stripe (International Cards, Apple Pay, Google Pay) ---
STRIPE_SECRET_KEY=sk_test_...

