{
    "name": "openwrapper/sdk",
    "version": "0.1.2",
    "description": "Provider-neutral payment integration SDK for OpenWrapper (Paymob, Fawry, Stripe).",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "OpenWrapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenWrapper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    }
}
