# ==============================================================================
# Merchant Application Environment Variables (@openwrapper/sdk)
# ==============================================================================

# Your OpenWrapper Gateway URL
OPENWRAPPER_BASE_URL=http://localhost:8080

# Your OpenWrapper API Key generated from the developer dashboard
OPENWRAPPER_API_KEY=ow_live_your_api_key_here

# ==============================================================================
# Your Payment Provider Credentials (Stateless / Passed per-request over TLS)
# ==============================================================================

# Paymob (Egypt)
PAYMOB_SECRET_KEY=sec_live_...
PAYMOB_PUBLIC_KEY=pub_live_...
PAYMOB_HMAC_SECRET=...
PAYMOB_INTEGRATION_ID=123456

# Fawry (Egypt)
FAWRY_MERCHANT_CODE=your_merchant_code
FAWRY_SECURE_KEY=your_secure_key

# Stripe (Global)
STRIPE_SECRET_KEY=sk_live_...
