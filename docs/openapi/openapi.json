{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenWrapper Gateway API",
    "version": "0.1.1",
    "description": "OpenWrapper is a high-performance, minimalist payment aggregation gateway providing a single, unified contract for payment creation, status reconciliation, and webhook normalization across disparate Egyptian payment providers (Paymob, Fawry)."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local Gateway Instance"
    },
    {
      "url": "https://pay.example.com",
      "description": "Production Gateway Instance"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/v1/payments": {
      "post": {
        "tags": ["Payments"],
        "summary": "Create Payment Intent",
        "description": "Initiates a payment across the specified provider. Requires an Idempotency-Key header.",
        "operationId": "createPayment",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Unique ASCII key (1–200 bytes, printable ASCII without whitespace) identifying this logical payment attempt.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "example": "order-98234-attempt-1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment initiated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentView"
                }
              }
            }
          },
          "200": {
            "description": "Existing payment record returned (idempotent duplicate request or recorded ambiguous outcome).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentView"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or idempotency payload conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream provider rejected the request with definite non-occurrence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/payments/{id}": {
      "get": {
        "tags": ["Payments"],
        "summary": "Get Payment Status",
        "description": "Retrieves current state of a payment, attempting active reconciliation if in unknown state.",
        "operationId": "getPayment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique OpenWrapper Payment ID (ULID string).",
            "schema": {
              "type": "string",
              "example": "01J6G7RPQZ4Z9M6W3V2T1K8N90"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current payment record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payment ID format or payment not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/{provider}": {
      "post": {
        "tags": ["Webhooks"],
        "summary": "Ingest Provider Webhook",
        "description": "Endpoint for upstream provider asynchronous payment notifications.",
        "operationId": "ingestWebhook",
        "security": [],
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "description": "Provider identifier (e.g. paymob or fawry).",
            "schema": {
              "type": "string",
              "enum": ["paymob", "fawry"],
              "example": "paymob"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook verified, processed, and deduplicated.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "ok"
                }
              }
            }
          },
          "400": {
            "description": "Malformed webhook payload or amount mismatch."
          },
          "401": {
            "description": "Missing or invalid cryptographic webhook signature."
          },
          "404": {
            "description": "Unknown or unconfigured provider."
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "tags": ["System"],
        "summary": "Liveness Probe",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is running.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "version": {
                      "type": "string",
                      "example": "0.1.1"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/ready": {
      "get": {
        "tags": ["System"],
        "summary": "Readiness Probe",
        "operationId": "getReadiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Gateway is ready to serve traffic.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ready"
                    },
                    "version": {
                      "type": "string",
                      "example": "0.1.1"
                    },
                    "store": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Store connectivity failed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "not_ready"
                    },
                    "error": {
                      "type": "string",
                      "example": "database connection timeout"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/version": {
      "get": {
        "tags": ["System"],
        "summary": "Version Information",
        "operationId": "getVersion",
        "security": [],
        "responses": {
          "200": {
            "description": "Version metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string",
                      "example": "0.1.1"
                    },
                    "service": {
                      "type": "string",
                      "example": "openwrapper-gateway"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "64-character hex secret configured via OPENWRAPPER_API_KEYS."
      }
    },
    "schemas": {
      "CreatePaymentRequest": {
        "type": "object",
        "required": [
          "provider",
          "amount_minor_units",
          "currency",
          "customer"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "description": "Integrated payment provider identifier.",
            "example": "paymob",
            "enum": ["paymob", "fawry"]
          },
          "amount_minor_units": {
            "type": "integer",
            "format": "int64",
            "description": "Payment amount in integer minor currency units (e.g. 1000 = 10.00 EGP).",
            "minimum": 1,
            "example": 1000
          },
          "currency": {
            "type": "string",
            "description": "Closed 3-letter ISO-4217 currency code.",
            "example": "EGP",
            "enum": ["EGP", "USD", "EUR", "GBP", "SAR", "AED"]
          },
          "customer": {
            "$ref": "#/components/schemas/CustomerDetails"
          },
          "merchant_reference": {
            "type": "string",
            "nullable": true,
            "description": "Optional merchant internal order/transaction reference.",
            "example": "order-2026-08-29-001"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Optional payment description for line items or statement descriptor.",
            "example": "Premium Annual Subscription"
          },
          "return_url": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "Customer redirect return URL after checkout completion.",
            "example": "https://merchant.example/checkout/complete"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Custom key-value metadata pairs.",
            "example": {
              "tier": "pro",
              "user_id": "usr_9981"
            }
          }
        }
      },
      "CustomerDetails": {
        "type": "object",
        "required": ["phone"],
        "properties": {
          "phone": {
            "type": "string",
            "description": "Customer mobile phone number.",
            "example": "+201234567890"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "description": "Customer email address.",
            "example": "customer@example.com"
          },
          "full_name": {
            "type": "string",
            "nullable": true,
            "description": "Customer full display name.",
            "example": "Ahmed Hassan"
          }
        }
      },
      "PaymentStatus": {
        "type": "string",
        "description": "Authoritative payment status in the finite state machine.",
        "enum": ["pending", "succeeded", "failed", "unknown"],
        "example": "pending"
      },
      "PaymentNextAction": {
        "type": "object",
        "discriminator": {
          "propertyName": "type"
        },
        "required": ["type"],
        "oneOf": [
          {
            "$ref": "#/components/schemas/RedirectToUrlAction"
          },
          {
            "$ref": "#/components/schemas/PayAtReferenceAction"
          }
        ]
      },
      "RedirectToUrlAction": {
        "type": "object",
        "required": ["type", "url"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["redirect_to_url"],
            "example": "redirect_to_url"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Provider-hosted checkout URL.",
            "example": "https://accept.paymob.com/unifiedcheckout/?publicKey=pk_test_123&clientSecret=cs_456"
          }
        }
      },
      "PayAtReferenceAction": {
        "type": "object",
        "required": ["type", "reference"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["pay_at_reference"],
            "example": "pay_at_reference"
          },
          "reference": {
            "type": "string",
            "description": "Reference code for customer payment at kiosk, ATM, or retail outlet.",
            "example": "982348123"
          },
          "instructions": {
            "type": "string",
            "nullable": true,
            "description": "Optional provider instructions or expiry timeline.",
            "example": "Pay before 2026-08-30 18:00 at any Fawry retail point."
          }
        }
      },
      "PaymentView": {
        "type": "object",
        "required": [
          "payment_id",
          "provider",
          "status",
          "amount_minor_units",
          "currency"
        ],
        "properties": {
          "payment_id": {
            "type": "string",
            "description": "Unique OpenWrapper Payment ID (ULID format).",
            "example": "01J6G7RPQZ4Z9M6W3V2T1K8N90"
          },
          "provider": {
            "type": "string",
            "description": "Payment provider adapter handling this payment.",
            "example": "paymob"
          },
          "provider_reference": {
            "type": "string",
            "nullable": true,
            "description": "Provider-assigned transaction id or correlation reference.",
            "example": "2556706"
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "amount_minor_units": {
            "type": "integer",
            "format": "int64",
            "description": "Amount in integer minor units.",
            "example": 1000
          },
          "currency": {
            "type": "string",
            "description": "ISO-4217 3-letter currency code.",
            "example": "EGP"
          },
          "merchant_reference": {
            "type": "string",
            "nullable": true,
            "description": "Merchant reference passed at creation.",
            "example": "order-2026-08-29-001"
          },
          "next_action": {
            "$ref": "#/components/schemas/PaymentNextAction"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code.",
            "example": "validation_error",
            "enum": [
              "validation_error",
              "authentication_error",
              "authorization_error",
              "configuration_error",
              "network_error",
              "timeout_error",
              "provider_error",
              "rate_limit_error",
              "unsupported_capability",
              "security_error",
              "unknown_outcome",
              "internal_error"
            ]
          },
          "message": {
            "type": "string",
            "description": "Human-readable, deterministic explanation of the error.",
            "example": "invalid Idempotency-Key: cannot be empty or contain whitespace"
          }
        }
      }
    }
  }
}
