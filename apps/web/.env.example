# ==============================================================================
# OpenWrapper Web Portal & API Server (.env.example)
# Version: 0.1.3 LTS
#
# QUICK START:
#   cp .env.example .env.local
#
# NOTE: You do NOT need any Paymob, Fawry, or Stripe credentials here!
# In OpenWrapper's zero-knowledge architecture, merchants supply their own
# credentials via SDK headers or manage API keys through the dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE PERSISTENCE (POSTGRESQL & PGBOUNCER)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string (used for schema migrations and Drizzle ORM)
DATABASE_URL=postgres://openwrapper:change-me@127.0.0.1:5432/openwrapper

# Optional PgBouncer transaction-mode connection pooler URL (recommended for production)
# Takes precedence over DATABASE_URL when set.
# DATABASE_POOLER_URL=postgres://openwrapper:change-me@127.0.0.1:6432/openwrapper

# ------------------------------------------------------------------------------
# 2. BETTER AUTH SESSION & SECURITY
# ------------------------------------------------------------------------------
# High-entropy encryption secret for user authentication and session cookies.
# Minimum 32 characters. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-secure-random-32char-string

# Canonical public base URL of the Next.js web portal (used for auth callbacks and redirects)
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. RUST GATEWAY IPC BRIDGES (HTTP REST & HIGH-PERFORMANCE gRPC)
# ------------------------------------------------------------------------------
# HTTP/REST fallback bridge to the Rust gateway process
OPENWRAPPER_GATEWAY_URL=http://127.0.0.1:8080

# Sub-millisecond gRPC IPC socket for payment creation and ledger streaming
OPENWRAPPER_GATEWAY_GRPC_ADDR=127.0.0.1:50051

# gRPC deadline in milliseconds before automatically falling back to HTTP REST
OPENWRAPPER_GRPC_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 4. OPTIONAL ENVIRONMENT CONTROLS
# ------------------------------------------------------------------------------
# Node.js environment
NODE_ENV=development

# Optional public dashboard URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
