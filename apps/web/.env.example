# ==============================================================================
# OpenWrapper Web Portal & API Server (.env.example)
#
# NOTE: You do NOT need any Paymob, Fawry, or Stripe credentials here!
# Merchants supply their own credentials inside their own applications via the SDK.
# ==============================================================================

# 1. PostgreSQL Connection String
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/openwrapper

# 2. Better Auth Configuration
BETTER_AUTH_SECRET=change-me-to-a-secure-random-32char-string
BETTER_AUTH_URL=http://localhost:3000

# 3. Gateway Internal URL (Optional)
OPENWRAPPER_GATEWAY_URL=http://127.0.0.1:8080
