# ==============================================================================
# OpenWrapper Web Portal & Developer Platform (.env.example)
# ==============================================================================

# PostgreSQL Connection String
DATABASE_URL=postgres://openwrapper:openwrapper@127.0.0.1:5432/openwrapper

# Better Auth Configuration
BETTER_AUTH_SECRET=change-me-to-a-random-32-character-secret
BETTER_AUTH_URL=http://localhost:3000

# OpenWrapper Rust Gateway Bridge (optional; leave unset for standalone mode)
OPENWRAPPER_GATEWAY_URL=http://127.0.0.1:8080

# ==============================================================================
# Payment Provider Credentials (Optional; built-in deterministic sandbox is active)
# ==============================================================================

# Paymob (Egypt)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
PAYMOB_NOTIFICATION_URL=http://localhost:3000/api/v1/webhooks/paymob

# Fawry (Egypt)
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com

# Stripe (Global)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
