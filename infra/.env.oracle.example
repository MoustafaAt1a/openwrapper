# ==============================================================================
# OpenWrapper Oracle Cloud Always Free + Cloudflare Configuration (.env)
# ==============================================================================
# Copy this file to .env.oracle or .env before running scripts/deploy.sh:
#   cp .env.oracle.example .env
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. Cloudflare Domain & Zero Trust Tunnel
# ──────────────────────────────────────────────────────────────────────────────
# Your root apex or subdomain on Cloudflare (e.g., example.com)
CLOUDFLARE_DOMAIN=example.com

# Token generated in Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiZXhhbXBsZXRva2Vu...

# ──────────────────────────────────────────────────────────────────────────────
# 2. Database & Connection Pooling (PostgreSQL 16 & PgBouncer)
# ──────────────────────────────────────────────────────────────────────────────
# Strong random password for the internal PostgreSQL and PgBouncer user
POSTGRES_PASSWORD=generate_a_very_strong_password_here_32_chars

# ──────────────────────────────────────────────────────────────────────────────
# 3. Message Bus (RabbitMQ 3.13)
# ──────────────────────────────────────────────────────────────────────────────
RABBITMQ_USER=openwrapper
RABBITMQ_PASSWORD=generate_another_strong_password_here

# ──────────────────────────────────────────────────────────────────────────────
# 4. OpenWrapper Gateway Engine (Stateless Replicas)
# ──────────────────────────────────────────────────────────────────────────────
# Comma-separated API keys for authorized clients accessing /v1/payments
OPENWRAPPER_API_KEYS=ow_live_sk_prod_primary_key_here,ow_live_sk_prod_secondary_key_here

# Rate limit per second per API key / IP (distributed via Valkey 8)
OPENWRAPPER_RATE_LIMIT_PER_SEC=200

# Background reconciliation loop interval in seconds
OPENWRAPPER_RECONCILIATION_INTERVAL_SECS=60

# ──────────────────────────────────────────────────────────────────────────────
# 5. Next.js Web Dashboard & Developer Portal
# ──────────────────────────────────────────────────────────────────────────────
# Run `openssl rand -base64 32` to generate
BETTER_AUTH_SECRET=generate_a_random_32_char_hex_or_base64_string

# ──────────────────────────────────────────────────────────────────────────────
# 6. Observability (Prometheus & Grafana)
# ──────────────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_to_a_secure_admin_password_123

# ──────────────────────────────────────────────────────────────────────────────
# 7. Cloudflare R2 Automated Off-Site Backups (Free 10 GB S3 Tier)
# ──────────────────────────────────────────────────────────────────────────────
# From Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=openwrapper-backups

# ──────────────────────────────────────────────────────────────────────────────
# 8. Payment Provider Integrations (Optional / Set when enabled)
# ──────────────────────────────────────────────────────────────────────────────
# Paymob (Egypt, UAE, KSA, Oman, Pakistan)
OPENWRAPPER_ENABLE_PAYMOB=false
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_IDS=
PAYMOB_NOTIFICATION_URL=

# Fawry (Egypt reference codes & wallets)
OPENWRAPPER_ENABLE_FAWRY=false
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_BASE_URL=https://atfawry.com

# Stripe (Global Cards, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
