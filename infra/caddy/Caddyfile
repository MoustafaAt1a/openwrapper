# ==============================================================================
# OpenWrapper Production Caddyfile (Load Balancer & Reverse Proxy)
# ==============================================================================
# Ingress routing for Rust Gateway and Next.js Web Portal behind Cloudflare.
# ==============================================================================

{
    admin :2019
    auto_https off
}

# 1. Rust Gateway API & Webhook Ingress (gateway.openwrapper.muejam.com)
gateway.openwrapper.muejam.com:80 {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    handle /metrics {
        reverse_proxy gateway-1:8080 gateway-2:8080 {
            lb_policy round_robin
        }
    }

    handle {
        reverse_proxy gateway-1:8080 gateway-2:8080 {
            lb_policy round_robin
            health_uri /v1/ready
            health_interval 5s
            health_timeout 2s
            health_status 2xx
            fail_duration 10s
            max_fails 2
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
    }

    log {
        output stdout
        format filter {
            request>headers delete
        }
        level INFO
    }
}

# 2. Next.js Web Portal & Fallback Ingress (openwrapper.muejam.com)
openwrapper.muejam.com:80, :80 {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Internal Prometheus metrics scrape
    handle /metrics {
        reverse_proxy gateway-1:8080 gateway-2:8080 {
            lb_policy round_robin
        }
    }

    # Gateway API fallback on apex domain for /v1/*
    handle /v1/* {
        reverse_proxy gateway-1:8080 gateway-2:8080 {
            lb_policy round_robin
            health_uri /v1/ready
            health_interval 5s
            health_timeout 2s
            health_status 2xx
            fail_duration 10s
            max_fails 2
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
    }

    # Next.js Web Application & Dashboard
    handle {
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    log {
        output stdout
        format filter {
            request>headers delete
        }
        level INFO
    }
}
