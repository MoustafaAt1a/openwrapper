{
  "name": "openwrapper-monorepo",
  "version": "0.1.3",
  "private": true,
  "description": "OpenWrapper Payment Gateway Monorepo",
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/web",
    "sdk/typescript",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run --cwd apps/web start",
    "ci": "bash scripts/ci-full.sh",
    "ci:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "clean": "bash scripts/clean.sh",
    "build": "bun run --cwd sdk/typescript build && bun run --cwd apps/web build",
    "lint": "bunx @biomejs/biome check --write .",
    "format": "bunx @biomejs/biome format --write .",
    "test": "bun test sdk/typescript/test/client.test.mjs && bun run --cwd apps/web test",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump",
    "version:sync": "node scripts/version.mjs sync",
    "railway:plan": "railway config plan",
    "railway:apply": "railway config apply"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "railway": "^3.11.0"
  }
}
