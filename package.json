{
  "name": "openwrapper-monorepo",
  "version": "0.2.7",
  "private": true,
  "description": "OpenWrapper Payment Gateway Monorepo",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "start": "pnpm --filter openwrapper start",
    "ci": "bash scripts/ci-full.sh",
    "ci:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "clean": "bash scripts/clean.sh",
    "build": "pnpm --filter @openwrapper/sdk build && pnpm --filter openwrapper build",
    "lint": "oxlint apps/web sdk/typescript",
    "format": "oxfmt --write apps/web sdk/typescript",
    "format:check": "oxfmt --check apps/web sdk/typescript",
    "test": "pnpm --filter @openwrapper/sdk test && pnpm --filter openwrapper test",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump",
    "version:sync": "node scripts/version.mjs sync",
    "railway:plan": "railway config plan",
    "railway:apply": "railway config apply"
  },
  "devDependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "railway": "^3.11.0"
  }
}
