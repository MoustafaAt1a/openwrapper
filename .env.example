# ==============================================================================
# OpenWrapper Platform Environment Variables
# Copy to .env and fill in real values. Never commit the real .env file.
# ==============================================================================

# ==============================================================================
# 1. Gateway Server Configuration (Rust Gateway)
# ==============================================================================
PORT=8080
OPENWRAPPER_BIND_ADDR=0.0.0.0:8080
OPENWRAPPER_LOG_FORMAT=text # "text" or "json"

# Database Configuration (Postgres recommended for multi-replica):
OPENWRAPPER_DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/openwrapper

# Distributed rate limiter cache (optional, e.g. Valkey/Dragonfly/Redis):
# OPENWRAPPER_CACHE_URL=redis://127.0.0.1:6379

# Inbound rate limiting: max requests per second
OPENWRAPPER_RATE_LIMIT_PER_SEC=50

# Background reconciliation loop interval in seconds (default 60; 0 to disable)
OPENWRAPPER_RECONCILIATION_INTERVAL_SECS=60

# HTTP request timeout for gateway endpoints in seconds (default 30)
OPENWRAPPER_HTTP_TIMEOUT_SECS=30

# ==============================================================================
# 2. Master API Keys & Authentication
# ==============================================================================
# Master gateway fallback API key (for healthchecks or internal admin access):
OPENWRAPPER_API_KEYS=ow_live_master_gateway_secret_key_placeholder

# Set to true to disable auth explicitly during local development only:
OPENWRAPPER_DISABLE_AUTH=false

# ==============================================================================
# 3. Next.js Web Portal & Better Auth Configuration
# ==============================================================================
# PostgreSQL Connection String for Next.js Web Portal
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/openwrapper

# 32+ character random secret for session encryption (e.g. `openssl rand -hex 32`)
BETTER_AUTH_SECRET=change-me-to-a-secure-random-32char-string
BETTER_AUTH_URL=http://localhost:3000

# Rust Gateway internal bridge URL (optional)
OPENWRAPPER_GATEWAY_URL=http://127.0.0.1:8080

# ==============================================================================
# 4. Default Server-Level Payment Providers (Optional)
# NOTE: In hosted SaaS mode, merchants pass their own credentials statelessly
# via headers (X-Paymob-*, X-Fawry-*, X-Stripe-*) or SDK options.
# ==============================================================================

# Paymob (Egypt)
OPENWRAPPER_ENABLE_PAYMOB=false
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
PAYMOB_NOTIFICATION_URL=https://your-domain.example/api/v1/webhooks/paymob

# Fawry (Egypt)
OPENWRAPPER_ENABLE_FAWRY=false
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com

# Stripe (Global)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
