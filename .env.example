# ==============================================================================
# OpenWrapper Platform Server Environment (.env.example)
#
# NOTE: As the platform host, YOU DO NOT NEED ANY PAYMOB, FAWRY, OR STRIPE KEYS HERE.
# In OpenWrapper's stateless zero-knowledge architecture, each merchant user
# puts their own provider keys in THEIR OWN project's .env and passes them
# via the SDK/headers.
# ==============================================================================

# 1. Server Ports
PORT=8080
OPENWRAPPER_BIND_ADDR=0.0.0.0:8080
OPENWRAPPER_LOG_FORMAT=text # "text" or "json"

# 2. PostgreSQL Database (Used by Rust Gateway & Next.js Portal)
# Direct Postgres connection (migrations, admin, local dev without Docker)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://openwrapper:change-me@127.0.0.1:5432/openwrapper
OPENWRAPPER_DATABASE_URL=postgres://openwrapper:change-me@127.0.0.1:5432/openwrapper

# PgBouncer pooler URL (preferred for app traffic in Docker / production)
# Use port 6432 and the pgbouncer host when running via docker compose.
DATABASE_POOLER_URL=postgres://openwrapper:change-me@127.0.0.1:6432/openwrapper

# PgBouncer container upstream settings (infra/pgbouncer — set by compose)
PGHOST=postgres
PGPORT=5432
PGDATABASE=openwrapper
PGUSER=openwrapper
PGPASSWORD=change-me

# 3. RabbitMQ Message Bus (optional — gateway falls back to in-process handlers when unset)
RABBITMQ_USER=openwrapper
RABBITMQ_PASSWORD=change-me
OPENWRAPPER_AMQP_URL=amqp://openwrapper:change-me@127.0.0.1:5672/openwrapper
# OPENWRAPPER_AMQP_WEBHOOK_QUEUE=openwrapper.webhooks
# OPENWRAPPER_AMQP_RECONCILE_QUEUE=openwrapper.reconciliation
# OPENWRAPPER_AMQP_PREFETCH=1
# OPENWRAPPER_AMQP_MAX_RETRIES=3

# 4. Next.js Web Authentication (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-secure-random-32char-string
BETTER_AUTH_URL=http://localhost:3000

# 5. Gateway API Keys (comma-separated)
OPENWRAPPER_API_KEYS=ow_test_key_change_me

# 6. Optional Performance & Rate Limiting Settings
OPENWRAPPER_RATE_LIMIT_PER_SEC=50
OPENWRAPPER_RECONCILIATION_INTERVAL_SECS=60
OPENWRAPPER_HTTP_TIMEOUT_SECS=30
