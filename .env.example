# ==============================================================================
# OpenWrapper Platform & Gateway Configuration (.env.example)
# Version: 0.1.3 LTS
#
# QUICK START:
#   cp .env.example .env
#   # For zero-config local development, the defaults below will start the gateway
#   # on 127.0.0.1:8080 with a local SQLite database (openwrapper.sqlite3).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GATEWAY SERVER & NETWORK BINDING
# ------------------------------------------------------------------------------
# Server port (Cloud platforms like Railway, Render, Fly inject PORT automatically)
PORT=8080

# TCP host and port to bind when PORT is not provided
OPENWRAPPER_BIND_ADDR=127.0.0.1:8080

# Logging format: "text" (human-friendly console logs) or "json" (structured for Datadog/CloudWatch)
OPENWRAPPER_LOG_FORMAT=text

# Log filtering level (standard tracing_subscriber EnvFilter syntax: error, warn, info, debug, trace)
RUST_LOG=info

# ------------------------------------------------------------------------------
# 2. PERSISTENCE LAYER (PICK ONE: SQLITE OR POSTGRESQL)
# ------------------------------------------------------------------------------
# OpenWrapper supports two authoritative persistence engines:
#
# Option A: Local / Edge SQLite (Default - Single Instance)
#   - Automatically runs with WAL mode (PRAGMA journal_mode = WAL) and busy_timeout.
#   - Now with full multi-tenant ownership, API key validation, and last-used auditing.
#   - Default if unset: "openwrapper.sqlite3"
OPENWRAPPER_DATABASE_URL=openwrapper.sqlite3

# Option B: Enterprise PostgreSQL / PgBouncer (Required for Multi-Replica Clusters)
#   - Direct Postgres URL (migrations, admin, single-node):
#     OPENWRAPPER_DATABASE_URL=postgres://openwrapper:change-me@127.0.0.1:5432/openwrapper
#   - PgBouncer Pooler URL (recommended for high concurrency in Docker / Kubernetes):
#     OPENWRAPPER_DATABASE_URL=postgres://openwrapper:change-me@127.0.0.1:6432/openwrapper
#   - Note: When pointing to port 6432 or host containing "pgbouncer", statement_cache_mode=describe
#     is automatically appended for transaction-mode pooling safety.
DATABASE_URL=postgres://openwrapper:change-me@127.0.0.1:5432/openwrapper
DATABASE_POOLER_URL=postgres://openwrapper:change-me@127.0.0.1:6432/openwrapper
POSTGRES_PASSWORD=change-me

# PgBouncer container upstream settings (used by docker compose in infra/pgbouncer)
PGHOST=postgres
PGPORT=5432
PGDATABASE=openwrapper
PGUSER=openwrapper
PGPASSWORD=change-me

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (FAIL-CLOSED BY DEFAULT)
# ------------------------------------------------------------------------------
# Comma-separated list of valid static API keys for the gateway.
# Required for POST /v1/payments and GET /v1/payments/:id.
# The gateway REFUSES TO START if unset, unless OPENWRAPPER_DISABLE_AUTH=true.
# Generate a cryptographically secure key: openssl rand -hex 32
OPENWRAPPER_API_KEYS=ow_test_key_change_me

# Set to "true" to disable authentication (LOCAL DEVELOPMENT / TESTING ONLY - NEVER IN PRODUCTION)
OPENWRAPPER_DISABLE_AUTH=false

# Better-Auth secret for Next.js Web Developer Portal (32+ character random string)
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-secure-random-32char-string
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. HIGH-PERFORMANCE gRPC IPC BRIDGE
# ------------------------------------------------------------------------------
# Sub-millisecond gRPC interface implementing openwrapper.v1.PaymentGateway
OPENWRAPPER_GRPC_BIND_ADDR=0.0.0.0:50051
OPENWRAPPER_DISABLE_GRPC=false

# ------------------------------------------------------------------------------
# 5. DISTRIBUTED RATE LIMITING & CACHE (VALKEY / DRAGONFLY / REDIS)
# ------------------------------------------------------------------------------
# Maximum requests per second per IP for payment endpoints (webhooks and health are exempt)
OPENWRAPPER_RATE_LIMIT_PER_SEC=50

# Optional Redis-compatible cache URL for cross-replica shared rate limiting:
# OPENWRAPPER_CACHE_URL=redis://127.0.0.1:6379
# If unset, each gateway replica enforces an independent in-process token bucket.

# ------------------------------------------------------------------------------
# 6. ASYNCHRONOUS MESSAGE QUEUE (RABBITMQ AMQP)
# ------------------------------------------------------------------------------
# When unset, webhook and payment reconciliation processing runs in-process.
# Set OPENWRAPPER_AMQP_URL to enable durable RabbitMQ-backed asynchronous delivery.
RABBITMQ_USER=openwrapper
RABBITMQ_PASSWORD=change-me
# OPENWRAPPER_AMQP_URL=amqp://openwrapper:change-me@127.0.0.1:5672/openwrapper
# OPENWRAPPER_AMQP_WEBHOOK_QUEUE=openwrapper.webhooks
# OPENWRAPPER_AMQP_RECONCILE_QUEUE=openwrapper.reconciliation
# OPENWRAPPER_AMQP_PREFETCH=1
# OPENWRAPPER_AMQP_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 7. PAYMENT RECONCILIATION LOOP
# ------------------------------------------------------------------------------
# Interval in seconds to check for stale "Unknown" status payments against providers.
# Set to 0 to disable background reconciliation.
OPENWRAPPER_RECONCILIATION_INTERVAL_SECS=60

# ------------------------------------------------------------------------------
# 8. OPTIONAL STATIC PROVIDER CREDENTIALS (SERVER-SIDE)
# ------------------------------------------------------------------------------
# NOTE: In OpenWrapper's stateless zero-knowledge mode, you DO NOT NEED static provider
# credentials on the gateway! Merchants can pass credentials dynamically per-request
# via HTTP headers (X-Paymob-*, X-Fawry-*, X-Stripe-*).
#
# If you want the gateway to act as a self-hosted merchant gateway with fixed credentials,
# enable the providers below:

# --- Paymob (Egypt / MENA) ---
OPENWRAPPER_ENABLE_PAYMOB=false
# PAYMOB_SECRET_KEY=egy_sk_test_...
# PAYMOB_PUBLIC_KEY=egy_pk_test_...
# PAYMOB_HMAC_SECRET=...
# PAYMOB_INTEGRATION_IDS=12345,12346
# PAYMOB_NOTIFICATION_URL=http://127.0.0.1:8080/v1/webhooks/paymob
# PAYMOB_BASE_URL=https://accept.paymob.com

# --- Fawry Pay (Egypt Retail Kiosks & Cards) ---
OPENWRAPPER_ENABLE_FAWRY=false
# FAWRY_MERCHANT_CODE=1013970
# FAWRY_SECURE_KEY=...
# FAWRY_BASE_URL=https://atfawry.fawrystaging.com
# FAWRY_DEBUG_SIGNATURES=false

# --- Stripe (Global Cards & Wallets) ---
OPENWRAPPER_ENABLE_STRIPE=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_BASE_URL=https://api.stripe.com

