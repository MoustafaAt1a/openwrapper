# Copy to .env and fill in real values. Never commit the real .env file.

# ==============================================================================
# 1. Gateway Server Configuration
# ==============================================================================
OPENWRAPPER_BIND_ADDR=127.0.0.1:8080
OPENWRAPPER_LOG_FORMAT=text # "text" or "json"

# Store configuration:
# - SQLite (single instance): path like "openwrapper.sqlite3" (default)
# - Postgres (multi-replica): "postgres://user:pass@host:5432/dbname"
OPENWRAPPER_DATABASE_URL=openwrapper.sqlite3

# Distributed rate limiter cache (optional, e.g. Valkey/Dragonfly):
# OPENWRAPPER_CACHE_URL=redis://127.0.0.1:6379

# Inbound rate limiting: max requests per second per gateway/replica
OPENWRAPPER_RATE_LIMIT_PER_SEC=50

# Background reconciliation loop interval in seconds (default 60; 0 to disable)
OPENWRAPPER_RECONCILIATION_INTERVAL_SECS=60

# HTTP request timeout for gateway endpoints in seconds (default 30)
OPENWRAPPER_HTTP_TIMEOUT_SECS=30

# ==============================================================================
# 2. OpenWrapper API Authentication
# ==============================================================================
# Comma-separated list of API keys. Generate with: openssl rand -hex 32
OPENWRAPPER_API_KEYS=change-me-to-a-random-64-char-hex-string

# To disable auth explicitly during local dev (NEVER in production):
# OPENWRAPPER_DISABLE_AUTH=false

# ==============================================================================
# 3. Postgres (required if using docker-compose.yml)
# ==============================================================================
POSTGRES_PASSWORD=change-me-to-something-random

# ==============================================================================
# 4. Paymob Provider (Egypt)
# ==============================================================================
OPENWRAPPER_ENABLE_PAYMOB=false
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_IDS=
PAYMOB_NOTIFICATION_URL=https://your-domain.example/v1/webhooks/paymob
# Optional overrides for unconfirmed endpoint patterns:
# PAYMOB_INQUIRY_PATH_TEMPLATE=/api/acceptance/transactions/{id}
# PAYMOB_CHECKOUT_URL_TEMPLATE=https://accept.paymob.com/unifiedcheckout/?publicKey={public_key}&clientSecret={client_secret}

# ==============================================================================
# 5. Fawry Provider (Egypt)
# ==============================================================================
OPENWRAPPER_ENABLE_FAWRY=false
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
# Set to "true" to log expected/received signature diagnostic strings:
# FAWRY_DEBUG_SIGNATURES=false

# ==============================================================================
# 6. Stripe Provider (Global / Cards)
# ==============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==============================================================================
# 7. Next.js Web Portal & Authentication (Better-Auth)
# ==============================================================================
# Database URL for Web Portal (PostgreSQL)
DATABASE_URL=postgres://openwrapper:change-me-to-something-random@127.0.0.1:5432/openwrapper

# 32+ character random secret for JWT session encryption
BETTER_AUTH_SECRET=change-me-to-a-secure-random-32char-string
BETTER_AUTH_URL=http://localhost:3000

# Public domain name for automatic HTTPS Caddy reverse proxy
DOMAIN=localhost


